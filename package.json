{
  "name": "agents",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prebuild:scheduler": "turbo run build --filter=@agents/scheduler",
    "prescheduler": "pnpm run prebuild:scheduler",
    "scheduler": "node agents/scheduler/dist/cli.js start",
    "preagent-list": "pnpm run prebuild:scheduler",
    "agent-list": "node agents/scheduler/dist/cli.js list",
    "preagent-run": "pnpm run prebuild:scheduler",
    "agent-run": "node agents/scheduler/dist/cli.js run",
    "agent-logs": "bash -c 'tail -f \"$(ls -t agents/$0/logs/*.log 2>/dev/null | head -1)\"'",
    "scheduler:start": "pm2 start ecosystem.config.cjs",
    "scheduler:stop": "pm2 stop agents-scheduler",
    "scheduler:restart": "pnpm run prebuild:scheduler && pm2 restart agents-scheduler",
    "scheduler:status": "pm2 status agents-scheduler",
    "scheduler:logs": "pm2 logs agents-scheduler",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "api": "pnpm --filter=@agents/api dev",
    "api:build": "turbo run build --filter=@agents/api",
    "web": "pnpm --filter=@agents/web dev",
    "web:build": "turbo run build --filter=@agents/web",
    "db:migrate": "pnpm --filter=@agents/core db:migrate",
    "prerepo": "turbo run build --filter=@agents/core",
    "repo": "node agents/core/dist/cli/repo.js",
    "prepr-activity": "turbo run build --filter=@agents/core",
    "pr-activity": "node agents/core/dist/cli/pr-activity.js",
    "preconnector": "turbo run build --filter=@agents/core",
    "connector": "node agents/core/dist/cli/connector.js",
    "prejira": "turbo run build --filter=@agents/core",
    "jira": "node agents/core/dist/cli/jira.js",
    "premcp": "turbo run build --filter=@agents/core",
    "mcp": "node agents/core/dist/cli/mcp.js"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4"
}
