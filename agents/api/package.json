{
  "name": "@agents/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --ignore '../web/**' --ignore '../**/.vite-temp/**' --ignore '../**/dist/**' src/server.ts",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@agents/core": "workspace:*",
    "@agents/scheduler": "workspace:*",
    "@agents/sdk": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@hono/node-server": "^1.13.7",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^0.36.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.13",
    "node-cron": "^3.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vite": "^6.0.7"
  }
