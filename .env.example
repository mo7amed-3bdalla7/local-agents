# Anthropic — generate with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://agents:agents@localhost:5432/agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
POSTGRES_PORT=5432

# Adminer (DB inspector)
ADMINER_PORT=8080

# API + dashboard port (docker compose path)
AGENTS_PORT=3848

# Master key for the file-backed secrets adapter — used in Docker.
# Mint with: openssl rand -base64 32
# Persist across restarts; losing it makes every stored secret unreadable.
AGENTS_SECRETS_KEY=

# Optional: override default admin user on first boot
# AGENTS_DEFAULT_ADMIN_EMAIL=
# AGENTS_DEFAULT_ADMIN_PASSWORD=
# AGENTS_DEFAULT_ADMIN_NAME=

# Optional: GitHub auth used by pr_create / pr_comment / github_review
# executors (alternative to `gh auth login` inside the container)
# GH_TOKEN=

# Optional: override GitHub poller state dir
# GITHUB_STATE_DIR=

# Optional: Slack alerts for failed/timed-out/aborted runs
# SLACK_WEBHOOK_URL=

# Optional: host directory bind-mounted read-only at /host-repos in the
# api container — used by the /repos/new Browse picker to list local
# clones. Defaults to ~/workspace.
# HOST_REPOS_DIR=/Users/you/code
