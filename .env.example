# Anthropic — generate with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://agents:agents@localhost:5432/agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
POSTGRES_PORT=5432

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Adminer (DB inspector)
ADMINER_PORT=8080

# Scheduler webhook server
SCHEDULER_PORT=3847

# Optional: override GitHub poller state dir
# GITHUB_STATE_DIR=

# Optional: Slack alerts for failed/timed-out/aborted runs
# SLACK_WEBHOOK_URL=
